@@ -272,13 +273,20 @@ static int fonts_up(float scale) {
     uint8_t *data[N] = {};
     ImVector<ImWchar> ranges[N];
     int merged = 0;
+    int zh_i = -1;   // the kCjk entry of the menu language, when it is Chinese
+    for (int i = 0; i < N; i++)
+        if (!strcmp(menu_lang(), kCjk[i].lang)) zh_i = i;
     for (int i = 0; i < N; i++) {
         char path[512];
         uint64_t size = 0;
         if (!plat_font_path(kCjk[i].lang, path, sizeof path) || !(data[i] = plat_file_read(path, &size))) continue;
         merged++;
         ImFontGlyphRangesBuilder b;
